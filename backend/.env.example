# PostgreSQL connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/daybook

# Long random text. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

PORT=4000
APP_TIMEZONE=Asia/Karachi

# Frontend address (only needed if frontend runs on a different domain)
CORS_ORIGIN=http://localhost:5173

# First owner account (used once by `npm run seed`)
OWNER_NAME=Owner
OWNER_USERNAME=owner
OWNER_PASSWORD=change-this-password
BUSINESS_NAME=My Restaurant
